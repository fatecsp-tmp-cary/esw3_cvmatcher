FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir --no-deps . \
    && pip install --no-cache-dir "fastapi>=0.115" "uvicorn>=0.30"

EXPOSE 8001

USER 10001

CMD ["python", "-m", "src.mock_api", "--host", "0.0.0.0", "--port", "8001"]
