# PostgreSQL connection used by docker-compose.yml and the application.
# Copy this file to `.env` and adjust values as needed; `.env` is gitignored.
POSTGRES_USER=cvmatch
POSTGRES_PASSWORD=cvmatch
POSTGRES_DB=cvmatch
POSTGRES_PORT=5432

# Full connection string, derived from the values above.
DATABASE_URL=postgresql://cvmatch:cvmatch@localhost:5432/cvmatch
